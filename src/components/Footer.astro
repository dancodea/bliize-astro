---
interface Props {
  footerClass?: string;
}

const { footerClass = "wpo-site-footer" } = Astro.props;
---

<footer class={footerClass}>
  <div class="wpo-upper-footer">
    <div class="container-fluid">
      <div class="row">
        <div class="col col-lg-3 col-md-6 col-sm-12 col-12 fade_bottom">
          <div class="widget about-widget">
            <div class="logo widget-title">
              <img src="/assets/images/logo-2.svg" alt="Bliize Logo" />
            </div>
            <p>
              Elit commodo nec urna erat morbi at hac turpis aliquam. In tristique elit nibh
              turpis. Lacus volutpat ipsum convallis tellus pellentesque etiam.
            </p>
            <div class="social-widget">
              <ul>
                <li><a href="#" aria-label="Facebook"><i class="ti-facebook"></i></a></li>
                <li><a href="#" aria-label="Twitter"><i class="ti-twitter-alt"></i></a></li>
                <li><a href="#" aria-label="LinkedIn"><i class="ti-linkedin"></i></a></li>
                <li><a href="#" aria-label="Instagram"><i class="ti-instagram"></i></a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col col-lg-3 col-md-6 col-sm-12 col-12 fade_bottom">
          <div class="widget link-widget">
            <div class="widget-title">
              <h3>Contact</h3>
            </div>
            <ul>
              <li>bliize@gmail.com</li>
              <li>+(208) 555-0112</li>
              <li>4517 Washington Ave.</li>
              <li>Manchter, Kentucky 495</li>
            </ul>
          </div>
        </div>
        <div class="col col-lg-3 col-md-6 col-sm-12 col-12 fade_bottom">
          <div class="widget link-widget">
            <div class="widget-title">
              <h3>Quick Link</h3>
            </div>
            <ul>
              <li><a href="/about"><span class="rolling-text">About Us</span></a></li>
              <li><a href="/services"><span class="rolling-text">Services</span></a></li>
              <li><a href="/projects"><span class="rolling-text">Projects</span></a></li>
              <li><a href="/blog"><span class="rolling-text">Blog</span></a></li>
              <li><a href="/contact"><span class="rolling-text">Contact</span></a></li>
            </ul>
          </div>
        </div>
        <div class="col col-lg-3 col-md-6 col-sm-12 col-12 fade_bottom">
          <div class="widget newsletter-widget">
            <div class="widget-title">
              <h3>Newsletter</h3>
            </div>
            <form action="#" onsubmit="return false;">
              <input type="email" class="input-fild" placeholder="Your Email..." required />
              <button type="submit">Subscribe</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="wpo-lower-footer">
    <div class="container-fluid">
      <div class="row g-0">
        <div class="col col-lg-6 col-12">
          <p class="copyright">Copyright &copy; 2024 Bliize. All Rights Reserved.</p>
        </div>
        <div class="col col-lg-6 col-12">
          <ul class="right">
            <li><a href="/privacy"><span class="rolling-text">Privacy &amp; Policy</span></a></li>
            <li><a href="/terms"><span class="rolling-text">Terms</span></a></li>
            <li><a href="/about"><span class="rolling-text">About us</span></a></li>
            <li><a href="/login"><span class="rolling-text">Login</span></a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
