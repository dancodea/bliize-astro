const headerProps = {
  "headerStyle": "wpo-header-style-s11",
  "topbar": true,
  "topbarStyle": "topbar topbar-s2",
  "logo": "/assets/images/logo.svg"
};
const footerProps = {};
---

<BaseLayout title="Bliize | Architecture Construction Template" headerProps={headerProps} footerProps={footerProps}>
