        <!-- Start header -->
        
        <!-- end of header -->

        <!-- start wpo-page-title -->
                <!-- start page-title -->
<section class="wpo-page-title">
    <div class="container">
        <div class="row">
            <div class="col col-xs-12">
                <div class="wpo-breadcumb-wrap">
                    <ol>
                                                    <li>Team</li>
                                            </ol>
                                            <h2 class="poort-text poort-in-right">Interior Designer, Expert Architect</h2>
                                    </div>
            </div>
        </div>
    </div>
</section>
<!-- end page-title -->        <!-- end page-title -->

        <!--===== start wpo-team-section =====-->
        <section class="wpo-team-section-s2 section-padding">
            <div class="container-fluid p-0">
                <div class="team-wrap">
                    <div class="row">
                        <div class="col-lg-3 col-md-6 col-12 fade_bottom">
                            <div class="team-card">
                                <div class="image">
                                    <img src="/assets/images/team/img-1.jpg" alt="team">
                                    <img src="/assets/images/team/img-1.jpg" alt="team">
                                </div>
                                <h2><a href="/team-single"> <span class="rolling-text">Robert&nbsp;Fox</span></a>
                                </h2>
                                <span>Senior Architect</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-12 fade_bottom">
