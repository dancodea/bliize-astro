                                    <img src="/assets/images/team/img-2.jpg" alt="team">
                                    <img src="/assets/images/team/img-2.jpg" alt="team">
                                </div>
                                <h2><a href="/team-single"> <span class="rolling-text">Harry&nbsp;William</span></a>
                                </h2>
                                <span>Interior Designer</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-12 fade_bottom">
                            <div class="team-card">
                                <div class="image">
                                    <img src="/assets/images/team/img-3.jpg" alt="team">
                                    <img src="/assets/images/team/img-3.jpg" alt="team">
                                </div>
                                <h2><a href="/team-single"> <span class="rolling-text">Harvard&nbsp;Bunion</span></a>
                                </h2>
                                <span>Partner &amp; CEO</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-12 fade_bottom">
                            <div class="team-card">
                                <div class="image">
                                    <img src="/assets/images/team/img-4.jpg" alt="team">
                                    <img src="/assets/images/team/img-4.jpg" alt="team">
                                </div>
                                <h2><a href="/team-single"> <span class="rolling-text">Benzamin&nbsp;Simon</span></a>
                                </h2>
                                <span>Interior Designer</span>
                            </div>
                        </div>
                    </div>
                </div>
