---
import { ClientRouter } from "astro:transitions";
import Preloader from "../components/Preloader.astro";
import CustomCursor from "../components/CustomCursor.astro";
import BackToTop from "../components/BackToTop.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  headerProps?: {
    headerStyle?: string;
    topbar?: boolean;
    topbarStyle?: string;
    logo?: string;
    showCart?: boolean;
    showSearch?: boolean;
    showUser?: boolean;
    showContactBtn?: boolean;
    contactBtnText?: string;
    contactBtnHref?: string;
  };
  footerProps?: {
    footerClass?: string;
  };
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = "Bliize | Architecture Construction Template",
  headerProps = {},
  footerProps = {},
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="wpOceans" />
    <link rel="shortcut icon" type="image/png" href="/assets/images/favicon.png" />
    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <!-- Icon fonts -->
    <link href="/assets/css/themify-icons.css" rel="stylesheet" />
    <link href="/assets/css/flaticon.css" rel="stylesheet" />

    <!-- Bootstrap core CSS -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Plugins CSS -->
    <link href="/assets/css/animate.css" rel="stylesheet" />
    <link href="/assets/css/owl.carousel.css" rel="stylesheet" />
    <link href="/assets/css/owl.theme.css" rel="stylesheet" />
    <link href="/assets/css/slick.css" rel="stylesheet" />
    <link href="/assets/css/slick-theme.css" rel="stylesheet" />
    <link href="/assets/css/swiper.min.css" rel="stylesheet" />
    <link href="/assets/css/owl.transitions.css" rel="stylesheet" />
    <link href="/assets/css/jquery.fancybox.css" rel="stylesheet" />
    <link href="/assets/css/odometer-theme-default.css" rel="stylesheet" />

    <!-- Theme Custom CSS -->
    <link href="/assets/sass/style.css" rel="stylesheet" />

    <ClientRouter />
  </head>
  <body>
    <div class="page-wrapper">
      <Preloader />
      <CustomCursor />

      {!hideHeader && <Header {...headerProps} />}

      <slot />

      {!hideFooter && <Footer {...footerProps} />}

      <BackToTop />
    </div>

    <!-- Vendor Scripts (is:inline preserves global execution order) -->
    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/assets/js/modernizr.custom.js"></script>
    <script is:inline src="/assets/js/jquery-plugin-collection.js"></script>
    <script is:inline src="/assets/js/gsap.js"></script>
    <script is:inline src="/assets/js/gsap-scroll-smoother.js"></script>
    <script is:inline src="/assets/js/SmoothScroll.js"></script>
    <script is:inline src="/assets/js/gsap-scroll-trigger.js"></script>
    <script is:inline src="/assets/js/gsap-split-text.js"></script>
    <script is:inline src="/assets/js/simpleParallax.js"></script>

    <!-- Astro View Transitions Lifecycle Manager -->
    <script>
      import { initAll, cleanupBeforeSwap } from "../scripts/main.js";

      document.addEventListener("astro:page-load", () => {
        initAll();
      });

      document.addEventListener("astro:before-swap", () => {
        cleanupBeforeSwap();
      });
    </script>
  </body>
</html>
